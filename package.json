{
  "name": "@local/deepseek-chat-ui",
  "version": "1.14.0",
  "description": "DeepSeek chat-demo style conversation page for the DeepSeek Harness (DSH) Web UI",
  "license": "MIT",
  "author": "AlphaAntivoid",
  "homepage": "https://github.com/AlphaAntivoid/dsh-chat-replica#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaAntivoid/dsh-chat-replica.git"
  },
  "bugs": {
    "url": "https://github.com/AlphaAntivoid/dsh-chat-replica/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "chat-ui"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "type": "module",
  "scripts": {
    "test": "node test/render.test.cjs && node test/style.test.cjs && node test/metadata.test.cjs && node test/host.test.cjs",
    "bundle": "node scripts/bundle.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
